step-1: start
step-2: print "How many terms you want to print in square series? "
step-3: read Count
step-4: SquareNumber = 1
step-5: print "The first " + Count + " terms in square series are "
step-6: print SquareNumber
step-7: SquareNumber = SquareNumber + 1
step-8: SquareValue = SquareNumber * SquareNumber
step-9: if (SquareNumber <= Count)
          print ", " + SquareValue
          goto step-7
step-10: print ".\n"
step-11: stop
