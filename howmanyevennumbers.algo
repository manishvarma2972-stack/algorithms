step-1: start
step-2: print "How many even numbers you want to print? "
step-3: read Count
step-4: Counter = 0
step-5: print "The first " + Count + " even numbers are "
step-6: print (Counter * 2)
step-7: Counter = Counter + 1
step-8: if (Counter < Count)
          print ", "
          goto step-6
step-9: print ".\n"
step-10: stop
