step-1: start
step-2: print "Up to which number you want to print natural numbers? "
step-3: read Count
step-4: Counter = 1
step-5: print "The natural numbers up to " + Count + " are "
step-6: print Counter
step-7: if (Counter < Count):
          print ", "
          Counter = Counter + 1
          goto step-6
step-8: print ".\n"
step-9: stop
